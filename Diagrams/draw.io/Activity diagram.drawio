        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    Start(( )) --&gt; Open[\&quot;User: Open CodePulse\&quot;]\n    Open --&gt; Source{\&quot;User: Choose project source\&quot;}\n\n    Source --&gt;|\&quot;ZIP file\&quot;| Upload[\&quot;User: Upload Java project ZIP\&quot;]\n    Source --&gt;|\&quot;GitHub URL\&quot;| URL[\&quot;User: Enter public repository URL\&quot;]\n\n    Upload --&gt; Extract[\&quot;CodePulse: Inspect and extract ZIP\&quot;]\n    URL --&gt; Fetch[\&quot;CodePulse: Retrieve public repository from GitHub\&quot;]\n\n    Extract --&gt; InputMerge{\&quot; \&quot;}\n    Fetch --&gt; InputMerge\n    InputMerge --&gt; Validate[\&quot;CodePulse: Validate project input\&quot;]\n\n    Validate --&gt; Valid{\&quot;CodePulse: Is the project valid?\&quot;}\n    Valid --&gt;|\&quot;No\&quot;| Error[\&quot;CodePulse: Display error and correction guidance\&quot;]\n    Error --&gt; Source\n\n    Valid --&gt;|\&quot;Yes\&quot;| Begin[\&quot;User: Start analysis\&quot;]\n    Begin --&gt; Preserve[\&quot;CodePulse: Preserve original source and display progress\&quot;]\n    Preserve --&gt; Parse[\&quot;CodePulse: Parse Java classes and methods\&quot;]\n\n    Parse --&gt; Available{\&quot;CodePulse: Are analyzable units available?\&quot;}\n    Available --&gt;|\&quot;No\&quot;| Failed[\&quot;CodePulse: Display failure and diagnostics\&quot;]\n    Failed --&gt; Retry{\&quot;User: Try another project?\&quot;}\n    Retry --&gt;|\&quot;Yes\&quot;| Source\n    Retry --&gt;|\&quot;No\&quot;| EndMerge{\&quot; \&quot;}\n\n    Available --&gt;|\&quot;Yes\&quot;| Metrics[\&quot;CodePulse: Calculate code metrics\&quot;]\n    Metrics --&gt; Rules[\&quot;CodePulse: Apply smell detection rules\&quot;]\n    Rules --&gt; MLReady{\&quot;CodePulse: Are the ML model and required features available?\&quot;}\n\n    MLReady --&gt;|\&quot;Yes\&quot;| ML[\&quot;CodePulse: Run trained ML model\&quot;]\n    MLReady --&gt;|\&quot;No\&quot;| MLUnavailable[\&quot;CodePulse: Mark ML detection as unavailable\&quot;]\n\n    ML --&gt; DetectionMerge{\&quot; \&quot;}\n    MLUnavailable --&gt; DetectionMerge\n\n    DetectionMerge --&gt; Results[\&quot;CodePulse: Save and display findings and evidence\&quot;]\n    Results --&gt; ReviewMerge{\&quot; \&quot;}\n    ReviewMerge --&gt; Review[\&quot;User: Review findings and compare detector results\&quot;]\n\n    Review --&gt; Action{\&quot;User: Choose next action\&quot;}\n\n    Action --&gt;|\&quot;Export report\&quot;| Report[\&quot;CodePulse: Generate downloadable report\&quot;]\n    Report --&gt; ReviewMerge\n\n    Action --&gt;|\&quot;Review refactoring\&quot;| Select[\&quot;User: Select a finding\&quot;]\n    Select --&gt; Advice[\&quot;CodePulse: Display refactoring recommendations\&quot;]\n    Advice --&gt; WantPreview{\&quot;User: Request a preview?\&quot;}\n\n    WantPreview --&gt;|\&quot;No\&quot;| ReviewMerge\n    WantPreview --&gt;|\&quot;Yes\&quot;| Supported{\&quot;CodePulse: Is the transformation supported and eligible?\&quot;}\n\n    Supported --&gt;|\&quot;No\&quot;| Limit[\&quot;CodePulse: Explain limitations\&quot;]\n    Limit --&gt; ReviewMerge\n\n    Supported --&gt;|\&quot;Yes\&quot;| Copy[\&quot;CodePulse: Prepare proposed changes in a separate copy\&quot;]\n    Copy --&gt; Check[\&quot;CodePulse: Run available validation checks\&quot;]\n    Check --&gt; Compare[\&quot;CodePulse: Calculate before and after quality measurements\&quot;]\n    Compare --&gt; Inspect[\&quot;User: Review proposed changes, quality comparison and check statuses\&quot;]\n\n    Inspect --&gt; Accept{\&quot;User: Accept this proposal version?\&quot;}\n    Accept --&gt;|\&quot;No\&quot;| ReviewMerge\n    Accept --&gt;|\&quot;Yes\&quot;| Record[\&quot;CodePulse: Record acceptance and prepare output\&quot;]\n    Record --&gt; Download[\&quot;User: Download accepted patch or project copy\&quot;]\n    Download --&gt; ReviewMerge\n\n    Action --&gt;|\&quot;Analyze another project\&quot;| Source\n    Action --&gt;|\&quot;Finish\&quot;| EndMerge\n    EndMerge --&gt; Finish((( )))\n\n    classDef user fill:#FFF0DB,stroke:#9A6200,color:#111111;\n    classDef system fill:#EAF3FF,stroke:#2563EB,color:#111111;\n    classDef decision fill:#FFF9DB,stroke:#8A6500,color:#111111;\n    classDef terminal fill:#111111,stroke:#111111;\n    classDef merge fill:#FFFFFF,stroke:#555555;\n\n    class Open,Upload,URL,Begin,Review,Select,Inspect,Download user;\n    class Extract,Fetch,Validate,Error,Preserve,Parse,Failed,Metrics,Rules,ML,MLUnavailable,Results,Report,Advice,Limit,Copy,Check,Compare,Record system;\n    class Source,Valid,Available,Retry,MLReady,Action,WantPreview,Supported,Accept decision;\n    class Start,Finish terminal;\n    class InputMerge,DetectionMerge,ReviewMerge,EndMerge merge;\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="BSFFIrBdOYHl_xJrWj-z-1">
