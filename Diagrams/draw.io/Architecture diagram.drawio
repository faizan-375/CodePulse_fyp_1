        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n    USER[\&quot;Project User\&quot;]\n\n    subgraph T1[\&quot;Tier 1 - Presentation\&quot;]\n        UI[\&quot;React Web Interface\&quot;]\n        VIEWS[\&quot;Project Submission, Progress, Dashboard and Reports\&quot;]\n        UI --- VIEWS\n    end\n\n    subgraph T2[\&quot;Tier 2 - Application and Business Logic\&quot;]\n        API[\&quot;FastAPI Backend\&quot;]\n        JOBS[\&quot;Background Job Queue\&quot;]\n        WORKER[\&quot;Analysis Worker\&quot;]\n\n        INGEST[\&quot;Repository Manager\&quot;]\n        JAVA[\&quot;JavaParser and Symbol Resolution\&quot;]\n        METRICS[\&quot;Java Metrics and Context Extraction\&quot;]\n\n        RULES[\&quot;Rule-Based Detector\&quot;]\n        ML[\&quot;Saved ML Pipelines\&quot;]\n        POLICY[\&quot;Findings and Output Policy\&quot;]\n\n        RECOMMEND[\&quot;Refactoring Recommendations\&quot;]\n        REPORT[\&quot;Report Generator\&quot;]\n\n        REFACTOR[\&quot;Supported Refactoring on Temporary Copy\&quot;]\n        VALIDATE[\&quot;Syntax, Available Build and Test Checks\&quot;]\n        COMPARE[\&quot;Before and After Comparison\&quot;]\n\n        API --&gt; JOBS\n        JOBS --&gt; WORKER\n\n        WORKER --&gt; INGEST\n        INGEST --&gt; JAVA\n        JAVA --&gt; METRICS\n\n        METRICS --&gt; RULES\n        METRICS --&gt; ML\n\n        RULES --&gt; POLICY\n        ML --&gt; POLICY\n\n        POLICY --&gt; RECOMMEND\n        POLICY --&gt; REPORT\n\n        RECOMMEND -. \&quot;User requests supported preview\&quot; .-&gt; REFACTOR\n        REFACTOR --&gt; VALIDATE\n        VALIDATE --&gt; COMPARE\n    end\n\n    subgraph T3[\&quot;Tier 3 - Data\&quot;]\n        DB[(\&quot;PostgreSQL: Runs, Findings and Metrics\&quot;)]\n        FILES[\&quot;File Storage: Project Copies, Patches and Reports\&quot;]\n        ARTIFACTS[\&quot;Versioned Models, Feature Schema and Rule Configurations\&quot;]\n    end\n\n    GITHUB[\&quot;Public GitHub Repository\&quot;]\n    TRAIN[\&quot;Offline Dataset Preparation, Training and Evaluation\&quot;]\n\n    USER --&gt; UI\n    UI &lt;--&gt;|\&quot;REST API and Job Status\&quot;| API\n\n    GITHUB --&gt; INGEST\n    INGEST &lt;--&gt;|\&quot;Source Files\&quot;| FILES\n\n    API &lt;--&gt;|\&quot;Results and History\&quot;| DB\n    WORKER --&gt;|\&quot;Progress and Analysis Results\&quot;| DB\n    POLICY --&gt; DB\n\n    ARTIFACTS -. \&quot;Released Rules\&quot; .-&gt; RULES\n    ARTIFACTS -. \&quot;Released ML Pipelines\&quot; .-&gt; ML\n    TRAIN --&gt;|\&quot;Validated Detector Artifacts\&quot;| ARTIFACTS\n\n    REFACTOR --&gt;|\&quot;Candidate Patch\&quot;| FILES\n    COMPARE --&gt;|\&quot;Validation and Comparison Results\&quot;| DB\n    REPORT --&gt;|\&quot;Generated Reports\&quot;| FILES\n\n    classDef presentation fill:#DBEAFE,stroke:#2563EB,color:#111827;\n    classDef application fill:#DCFCE7,stroke:#16A34A,color:#111827;\n    classDef storage fill:#FEF3C7,stroke:#D97706,color:#111827;\n    classDef external fill:#F3E8FF,stroke:#9333EA,color:#111827;\n\n    class UI,VIEWS presentation;\n    class API,JOBS,WORKER,INGEST,JAVA,METRICS,RULES,ML,POLICY,RECOMMEND,REPORT,REFACTOR,VALIDATE,COMPARE application;\n    class DB,FILES,ARTIFACTS storage;\n    class USER,GITHUB,TRAIN external;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="nmru9L9n7vtzPS6KgPL6-55">
