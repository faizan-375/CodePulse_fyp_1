        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n    User[\&quot;👤 Project User\&quot;]\n    GitHub[\&quot;👤 GitHub&lt;br/&gt;Repository Service\&quot;]\n\n    subgraph CodePulse[\&quot;CodePulse — Java Code Smell Analysis and Refactoring\&quot;]\n        direction TB\n\n        Submit([\&quot;UC-01&lt;br/&gt;Submit Java&lt;br/&gt;Project\&quot;])\n        Analyze([\&quot;UC-02&lt;br/&gt;Analyze Java&lt;br/&gt;Project\&quot;])\n        Monitor([\&quot;UC-03&lt;br/&gt;Monitor Analysis&lt;br/&gt;Status\&quot;])\n        GodClass([\&quot;UC-04&lt;br/&gt;Detect&lt;br/&gt;God Class\&quot;])\n        FeatureEnvy([\&quot;UC-05&lt;br/&gt;Detect&lt;br/&gt;Feature Envy\&quot;])\n        Results([\&quot;UC-06&lt;br/&gt;Review Analysis&lt;br/&gt;Results\&quot;])\n        Evidence([\&quot;UC-07&lt;br/&gt;Inspect Finding&lt;br/&gt;and Evidence\&quot;])\n        CompareDetectors([\&quot;UC-08&lt;br/&gt;Compare Rule-Based&lt;br/&gt;and ML Findings\&quot;])\n        Architecture([\&quot;UC-09&lt;br/&gt;Explore Dependency&lt;br/&gt;and Architecture Findings\&quot;])\n        Debt([\&quot;UC-10&lt;br/&gt;Review Debt Estimates&lt;br/&gt;and Priorities\&quot;])\n        Export([\&quot;UC-11&lt;br/&gt;Export Analysis&lt;br/&gt;Report\&quot;])\n        History([\&quot;UC-12&lt;br/&gt;Reopen Saved&lt;br/&gt;Analysis\&quot;])\n\n        Recommendations([\&quot;UC-13&lt;br/&gt;Review Refactoring Recommendations&lt;br/&gt;────────────&lt;br/&gt;Extension point&lt;br/&gt;EP-01: Recommendation displayed\&quot;])\n\n        Preview([\&quot;UC-14&lt;br/&gt;Preview Supported&lt;br/&gt;Refactoring\&quot;])\n        Validate([\&quot;UC-15&lt;br/&gt;Validate Proposed&lt;br/&gt;Change\&quot;])\n        CompareQuality([\&quot;UC-16&lt;br/&gt;Compare Before&lt;br/&gt;and After Quality\&quot;])\n        ReviewChange([\&quot;UC-17&lt;br/&gt;Review Proposed Change&lt;br/&gt;and Validation Results\&quot;])\n        Accept([\&quot;UC-18&lt;br/&gt;Accept Proposed&lt;br/&gt;Change\&quot;])\n        Download([\&quot;UC-19&lt;br/&gt;Download Accepted Patch&lt;br/&gt;or Project Copy\&quot;])\n\n        Analyze -.-&gt;|\&quot;«include»\&quot;| GodClass\n        Analyze -.-&gt;|\&quot;«include»\&quot;| FeatureEnvy\n\n        Preview -.-&gt;|\&quot;«extend» at EP-01&lt;br/&gt;[user requests preview and&lt;br/&gt;transformation is supported]\&quot;| Recommendations\n\n        Preview -.-&gt;|\&quot;«include»\&quot;| Validate\n        Preview -.-&gt;|\&quot;«include»\&quot;| CompareQuality\n\n        N1[\&quot;Input: Public GitHub URL or ZIP upload.&lt;br/&gt;GitHub participates only for&lt;br/&gt;repository URL retrieval.\&quot;]\n\n        N2[\&quot;Precondition: Valid project available.&lt;br/&gt;Both target smells are analyzed&lt;br/&gt;using rules and trained ML models.\&quot;]\n\n        N3[\&quot;Check the proposed project copy.&lt;br/&gt;Report checks as passed, failed,&lt;br/&gt;unavailable or skipped.&lt;br/&gt;Preserve the original project.\&quot;]\n\n        N4[\&quot;Precondition: Proposed change and&lt;br/&gt;validation results have been reviewed.&lt;br/&gt;Record acceptance of the&lt;br/&gt;specific proposal version.\&quot;]\n\n        N5[\&quot;Precondition: Selected proposal is accepted.&lt;br/&gt;Download only.&lt;br/&gt;No automatic GitHub push.\&quot;]\n\n        Submit -.- N1\n        Analyze -.- N2\n        Validate -.- N3\n        Accept -.- N4\n        Download -.- N5\n    end\n\n    User ---|\&quot;submit code\&quot;| Submit\n    User ---|\&quot;start analysis\&quot;| Analyze\n    User ---|\&quot;check progress\&quot;| Monitor\n    User ---|\&quot;view findings\&quot;| Results\n    User ---|\&quot;inspect evidence\&quot;| Evidence\n    User ---|\&quot;compare detectors\&quot;| CompareDetectors\n    User ---|\&quot;explore dependencies\&quot;| Architecture\n    User ---|\&quot;review estimates\&quot;| Debt\n    User ---|\&quot;export report\&quot;| Export\n    User ---|\&quot;open saved results\&quot;| History\n    User ---|\&quot;review suggestions\&quot;| Recommendations\n    User ---|\&quot;request preview\&quot;| Preview\n    User ---|\&quot;inspect quality changes\&quot;| CompareQuality\n    User ---|\&quot;inspect proposed change\&quot;| ReviewChange\n    User ---|\&quot;approve proposal\&quot;| Accept\n    User ---|\&quot;download accepted output\&quot;| Download\n\n    Submit ---|\&quot;retrieve public repository\&quot;| GitHub\n\n    classDef actor fill:#FFFFFF,stroke:#222222,color:#111111,stroke-width:1.5px;\n    classDef usecase fill:#FFD8B0,stroke:#222222,color:#111111,stroke-width:1.5px;\n    classDef note fill:#FFF5BF,stroke:#777777,color:#222222,stroke-width:1px;\n\n    class User,GitHub actor;\n    class Submit,Analyze,Monitor,GodClass,FeatureEnvy,Results,Evidence,CompareDetectors,Architecture,Debt,Export,History,Recommendations,Preview,Validate,CompareQuality,ReviewChange,Accept,Download usecase;\n    class N1,N2,N3,N4,N5 note;\n\n    style CodePulse fill:#FAFAFA,stroke:#222222,stroke-width:2px,color:#111111;\n    linkStyle default stroke:#333333,color:#333333;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="0zUPMXKstpL5YPVk9HbF-75">
