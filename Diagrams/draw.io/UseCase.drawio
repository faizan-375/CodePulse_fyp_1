        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;usecase-beta\ndirection LR\n\nactor User(\&quot;Project User\&quot;)\nactor GitHub(\&quot;GitHub\&quot;)\n\nsystemBoundary CodePulse[\&quot;CodePulse - Java Code Smell Analysis and Refactoring\&quot;]\n    UC01(\&quot;Submit Java project\&quot;)\n    UC02(\&quot;Analyze Java project\&quot;)\n    UC03(\&quot;Detect Feature Envy\&quot;)\n    UC04(\&quot;Detect God Class\&quot;)\n\n    UC05(\&quot;Monitor analysis status\&quot;)\n    UC06(\&quot;Review analysis results\&quot;)\n    UC07(\&quot;Inspect finding and evidence\&quot;)\n    UC08(\&quot;Compare rule and ML findings\&quot;)\n\n    UC09(\&quot;Review refactoring recommendations\&quot;)\n    UC10(\&quot;Reopen saved analysis\&quot;)\n    UC11(\&quot;Export analysis report\&quot;)\n\n    UC12(\&quot;Review debt estimates and priorities\&quot;)\n    UC13(\&quot;Explore dependency and architecture findings\&quot;)\n\n    UC14(\&quot;Preview supported refactoring\&quot;)\n    UC15(\&quot;Review proposed change and validation\&quot;)\n    UC16(\&quot;Download accepted patch or project copy\&quot;)\n    UC17(\&quot;Validate proposed change\&quot;)\n    UC18(\&quot;Compare before and after quality\&quot;)\nend\n\n%% Actor participation\n\nUser -- UC01\nUser -- UC02\nUser -- UC05\nUser -- UC06\nUser -- UC07\nUser -- UC08\nUser -- UC09\nUser -- UC10\nUser -- UC11\nUser -- UC12\nUser -- UC13\nUser -- UC14\nUser -- UC15\nUser -- UC16\nUser -- UC18\n\nGitHub -- UC01\n\n%% Required detection behaviour\n\nUC02 ..&gt; : include UC03\nUC02 ..&gt; : include UC04\n\n%% Conditional refactoring extension\n\nUC14 ..&gt; : extend UC09\n\n%% Required behaviour when previewing a refactoring\n\nUC14 ..&gt; : include UC17\nUC14 ..&gt; : include UC18\n\n%% Conditions and extension point\n\nnote for UC01 \&quot;Public GitHub URL or ZIP upload. GitHub participates only for URL input.\&quot;\n\nnote for UC09 \&quot;Extension point EP1: recommendation displayed. Preview occurs when the user requests an implemented eligible transformation.\&quot;\n\nnote for UC17 \&quot;Report syntax and available build/test checks as passed, failed, unavailable or skipped.\&quot;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="JpkvkJ-4yhN6c4DkcS9R-159">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
