<mxfile host="app.diagrams.net">
  <diagram name="Page-1" id="dCWvwDcWrOmOCEk89yAj">
    <mxGraphModel dx="4074" dy="2374" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction TB\n\n    class ProjectService {\n        -GitHubRepositoryClient githubClient\n        +submitGitHubProject(String repositoryUrl) JavaProject\n        +submitZipProject(String zipPath) JavaProject\n    }\n\n    class GitHubRepositoryClient {\n        +retrievePublicRepository(String repositoryUrl) String\n    }\n\n    class JavaProject {\n        -String projectId\n        -String name\n        -String sourcePath\n    }\n\n    class AnalysisService {\n        -JavaAnalyzer analyzer\n        -AnalysisRepository repository\n        +startAnalysis(JavaProject project) String\n        +getAnalysisStatus(String analysisId) String\n        +getAnalysisResult(String analysisId) AnalysisResult\n    }\n\n    class JavaAnalyzer {\n        -RuleBasedDetector ruleDetector\n        -MLDetector mlDetector\n        +analyze(JavaProject project) AnalysisResult\n        +extractCodeUnits(JavaProject project) List~CodeUnit~\n        +calculateMetrics(CodeUnit unit) MetricSet\n    }\n\n    class CodeUnit {\n        -String qualifiedName\n        -String unitKind\n        -String filePath\n        -int startLine\n        -int endLine\n    }\n\n    class MetricSet {\n        -Map~String,Double~ values\n    }\n\n    class SmellDetector {\n        &lt;&lt;interface&gt;&gt;\n        +detect(CodeUnit unit, MetricSet metrics) List~Finding~\n    }\n\n    class RuleBasedDetector {\n        -String ruleSetVersion\n        +detect(CodeUnit unit, MetricSet metrics) List~Finding~\n    }\n\n    class MLDetector {\n        -String modelVersion\n        +detect(CodeUnit unit, MetricSet metrics) List~Finding~\n    }\n\n    class CodeSmellType {\n        &lt;&lt;enumeration&gt;&gt;\n        GOD_CLASS\n        FEATURE_ENVY\n    }\n\n    class DetectorType {\n        &lt;&lt;enumeration&gt;&gt;\n        RULE_BASED\n        ML\n    }\n\n    class Finding {\n        -String findingId\n        -CodeSmellType smellType\n        -String filePath\n        -int startLine\n        -int endLine\n        -List~DetectionEvidence~ evidence\n    }\n\n    class DetectionEvidence {\n        -DetectorType detectorType\n        -String detectorVersion\n        -String explanation\n        -Map~String,Double~ measurements\n    }\n\n    class AnalysisResult {\n        -String analysisId\n        -String projectId\n        -List~Finding~ findings\n    }\n\n    class AnalysisRepository {\n        &lt;&lt;interface&gt;&gt;\n        +save(AnalysisResult result) void\n        +findById(String analysisId) AnalysisResult\n        +listSavedAnalyses() List~AnalysisResult~\n    }\n\n    class ReportService {\n        +exportReport(AnalysisResult result, String format) String\n    }\n\n    class RefactoringService {\n        -ValidationService validationService\n        -QualityComparisonService qualityService\n        +recommend(Finding finding) List~RefactoringProposal~\n        +preview(JavaProject project, RefactoringProposal proposal) RefactoringProposal\n        +accept(RefactoringProposal proposal, String reviewedVersion) void\n        +downloadAcceptedOutput(RefactoringProposal proposal) String\n    }\n\n    class RefactoringProposal {\n        -String proposalId\n        -String findingId\n        -String version\n        -String description\n        -boolean supported\n        -boolean accepted\n        -String proposedCopyPath\n        -ValidationResult validationResult\n        -QualityComparison qualityComparison\n    }\n\n    class ValidationService {\n        +validate(String proposedCopyPath) ValidationResult\n    }\n\n    class ValidationResult {\n        -Map~String,String~ checkStatuses\n        -List~String~ messages\n    }\n\n    class QualityComparisonService {\n        +compare(String originalPath, String proposedCopyPath) QualityComparison\n    }\n\n    class QualityComparison {\n        -Map~String,Double~ beforeMetrics\n        -Map~String,Double~ afterMetrics\n    }\n\n    ProjectService --&gt; GitHubRepositoryClient : githubClient\n    ProjectService ..&gt; JavaProject : returns\n\n    AnalysisService --&gt; JavaAnalyzer : analyzer\n    AnalysisService --&gt; AnalysisRepository : repository\n    AnalysisService ..&gt; JavaProject : accepts\n    AnalysisService ..&gt; AnalysisResult : returns\n\n    JavaAnalyzer --&gt; RuleBasedDetector : ruleDetector\n    JavaAnalyzer --&gt; MLDetector : mlDetector\n    JavaAnalyzer ..&gt; JavaProject : analyzes\n    JavaAnalyzer ..&gt; CodeUnit : extracts\n    JavaAnalyzer ..&gt; MetricSet : calculates\n    JavaAnalyzer ..&gt; AnalysisResult : produces\n\n    RuleBasedDetector ..|&gt; SmellDetector\n    MLDetector ..|&gt; SmellDetector\n    SmellDetector ..&gt; CodeUnit : accepts\n    SmellDetector ..&gt; MetricSet : accepts\n    SmellDetector ..&gt; Finding : returns\n\n    Finding --&gt; \&quot;1\&quot; CodeSmellType : smellType\n    Finding --&gt; \&quot;1..*\&quot; DetectionEvidence : evidence\n    DetectionEvidence --&gt; \&quot;1\&quot; DetectorType : detectorType\n    AnalysisResult --&gt; \&quot;0..*\&quot; Finding : findings\n\n    AnalysisRepository ..&gt; AnalysisResult : saves and retrieves\n    ReportService ..&gt; AnalysisResult : exports\n\n    RefactoringService --&gt; ValidationService : validationService\n    RefactoringService --&gt; QualityComparisonService : qualityService\n    RefactoringService ..&gt; JavaProject : uses project copy\n    RefactoringService ..&gt; Finding : recommends for\n    RefactoringService ..&gt; RefactoringProposal : creates and updates\n\n    RefactoringProposal --&gt; \&quot;0..1\&quot; ValidationResult : validationResult\n    RefactoringProposal --&gt; \&quot;0..1\&quot; QualityComparison : qualityComparison\n    ValidationService ..&gt; ValidationResult : returns\n    QualityComparisonService ..&gt; QualityComparison : returns&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="zBc6bHFK1Z7yRRJCiSEI-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
